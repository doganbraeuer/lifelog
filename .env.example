MONGODB_URI=mongodb+srv://USER:PASSWORD@lifelog.m18t6ui.mongodb.net/
MONGODB_DB=lifelog
GEMINI_API_KEY=your-key

# Optional. Default: reachable only from this machine.
# 0.0.0.0 only for testing with a real phone; the backend is then reachable
# from the whole network.
ADDRESS=127.0.0.1
PORT=8080

# Optional. Empty = default from backend/internal/config (gemini-3.8-flash,
# gemini-embedding-2). Available models: cd backend && go run ./cmd/modelle
# CAUTION: after switching the embedding model, all chunks must be
# re-embedded.
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=

# Optional, empty by default (no fallback). If GEMINI_MODEL is still
# unavailable after two retries on 429/503, this model is tried once for
# reading, e.g. gemini-3.1-flash-lite.
# Not used for embeddings (vectors of different models do not match).
GEMINI_FALLBACK_MODEL=

# Optional, default 20 (0 to 35). This many seconds of the time limit are
# reserved for the fallback model, when reading (50 s) and when answering
# (45 s); the main model gets the rest, including retries. Only takes effect
# if GEMINI_FALLBACK_MODEL is set.
GEMINI_FALLBACK_RESERVE_SECONDS=

# Until 2026-11-09 these variables had German names (ADRESSE, GEMINI_MODELL,
# GEMINI_EMBEDDING_MODELL, GEMINI_MODELL_ERSATZ,
# GEMINI_ERSATZ_RESERVE_SEKUNDEN). The backend refuses to start while one of
# them is still set, so an old .env is not ignored silently.

MONGODB_URI=mongodb+srv://BENUTZER:PASSWORT@lifelog.m18t6ui.mongodb.net/
MONGODB_DB=lifelog
GEMINI_API_KEY=dein-schluessel

# Optional. Standard: nur vom eigenen Rechner erreichbar.
# 0.0.0.0 nur zum Testen mit einem echten Handy, dann ist das Backend im
# ganzen Netz erreichbar.
ADRESSE=127.0.0.1
PORT=8080

# Optional. Leer = Standard aus backend/internal/konfig (gemini-3.8-flash,
# gemini-embedding-2). Verfügbare Modelle: cd backend && go run ./cmd/modelle
# ACHTUNG: Nach einem Wechsel des Embedding-Modells müssen alle Abschnitte
# neu eingebettet werden.
GEMINI_MODELL=
GEMINI_EMBEDDING_MODELL=

# Optional, standardmäßig leer (kein Ersatz). Bleibt GEMINI_MODELL trotz
# zwei Wiederholungen bei 429/503 nicht erreichbar, wird dieses Modell
# einmal zum Lesen versucht, z. B. gemini-3.1-flash-lite.
# Gilt nicht für Embeddings (Vektoren verschiedener Modelle passen nicht zusammen).
GEMINI_MODELL_ERSATZ=

# Optional, Standard 20 (0 bis 35). So viele Sekunden des Limits bleiben dem
# Ersatzmodell vorbehalten, beim Lesen (50 s) und beim Antworten (45 s); das
# Hauptmodell bekommt samt Wiederholungen den Rest. Wirkt nur, wenn
# GEMINI_MODELL_ERSATZ gesetzt ist.
GEMINI_ERSATZ_RESERVE_SEKUNDEN=
